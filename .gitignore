# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
.venv2/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# ---------------------------------------------------------------- data
# Captures: 4K colour+depth frames. These are the measurements, not the code,
# and they do not belong in git.
images/
# Capture runs (capture_NNNN/ with frames + camera info). The README uses
# run_calibration as an example path; bring your own data.
run_*/
live_baseline/

# ------------------------------------------------------------ third party
# Leftover local checkouts from the removed GLU-Net path. Nothing in the
# pipeline imports them; delete the directories whenever you like.
glunet_src/
synthetic_dataset/

# ---------------------------------------------------------- rendered output
# Overlay and debug renders, all regenerable with
#   render_fit.py --src out/bundle.json --outdir out_overlays
out_overlays*/
out_annotated/
out_debug*/
results*/
boardpose/results*/

# ------------------------------------------------------ pipeline artefacts
# out/ mixes throwaway renders with the small calibration files the pipeline
# actually consumes. Exclude the CONTENTS (out/* -- not out/, or git will not
# descend into the directory and the negations below are silently ignored),
# then re-admit the reference artefacts worth versioning.
#
# What stays in git is only what a new user needs as a STARTING POINT:
#   bundle_rims6_v3.json   refined intrinsics + rim bias (a camera property)
#   kinematic_calib_v3.json  joint offsets + hand-eye (a robot property)
#   eval_multiview.json    the published precision numbers, so a regression
#                          in a fork is visible without re-running everything
# Your own runs overwrite these; that is intended. See docs/METHOD.md.
boardpose/out/*
!boardpose/out/bundle_rims6_v3.json
!boardpose/out/kinematic_calib_v3.json
!boardpose/out/eval_multiview.json

# Belt and braces: no bitmaps, archives or timestamped backups by any route.
*.png
*.jpg
*.bak.json
*.tar.gz
